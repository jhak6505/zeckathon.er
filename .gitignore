# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Distribution / packaging ──────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ── Type-checking ─────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
.pytype/

# ── Linting ───────────────────────────────────────────────────────────────────
.ruff_cache/

# ── Local / environment files ─────────────────────────────────────────────────
.env
.env.*
*.local

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Data files (keep structure, ignore content) ───────────────────────────────
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# ── SQLite database files ─────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
data/*.sqlite3

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

